<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link
      rel="stylesheet"
      href="/stylesheets/style.css"
    />

    <link
      rel="stylesheet"
      href="/stylesheets/partials.css"
    />

    <title>Confirm Order | OFRA BH</title>
  </head>

  <body>

    <%- include('../partials/_navbar.ejs') %>

    <main class="confirm-order-page">

      <section class="confirm-order-card">

        <p class="product-small-title">
          OFRA BH
        </p>

        <h1>
          Confirm Your Order
        </h1>

        <div class="heading-decoration">
          <span></span>
          <span class="heart">♥</span>
          <span></span>
        </div>

        <p class="confirm-order-message">
          Please check your order before confirming.
        </p>

        <div class="confirm-products">

          <% cart.forEach((product) => { %>

            <div class="confirm-product-row">

              <span>
                <%= product.name %>
              </span>

              <span>
                <%= product.price %> BD
              </span>

            </div>

          <% }) %>

        </div>

        <div class="confirm-total">

          <span>
            Total
          </span>

          <strong>
            <%= total %> BD
          </strong>

        </div>

        <form
          action="/cart/checkout"
          method="POST"
        >

          <button
            type="submit"
            class="confirm-order-button"
          >
            Confirm Order
          </button>

        </form>

        <a
          href="/cart"
          class="back-link"
        >
          Back to Cart
        </a>

      </section>

    </main>

    <%- include('../partials/_footer.ejs') %>

  </body>

</html>