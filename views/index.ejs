<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />

    <title>OFRA BH</title>
  </head>

  <body>
    <%- include('./partials/_navbar.ejs') %>

    <main class="landing-page">
      <section class="landing-image">
        <img
          src="/images/ofra-home.png"
          alt="OFRA beauty collection"
        />
      </section>

      <section class="landing-content">
        <h1>
          YOUR GLOW,<br />
          YOUR WAY
        </h1>

        <% if (user) { %>
          <p class="landing-welcome">
            Welcome, <%= user.username %>
          </p>

          <a href="/products" class="main-button">
            View Products
          </a>

          <a href="/products/new" class="main-button">
            Add Product
          </a>
        <% } else { %>
          <a href="/auth/sign-up" class="main-button">
            Sign Up
          </a>

          <a href="/auth/sign-in" class="main-button">
            Sign In
          </a>
        <% } %>

        <p class="landing-tagline">
          Highlight • Define • Glow
        </p>
      </section>
    </main>

    <%- include('./partials/_footer.ejs') %>
  </body>
</html>