<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Add Product | OFRA BH</title>

    <link
      rel="stylesheet"
      href="/stylesheets/style.css"
    />

    <link
      rel="stylesheet"
      href="/stylesheets/partials.css"
    />
  </head>

  <body>
    <%- include('../partials/_navbar.ejs') %>

    <main class="auth-page">

      <section class="auth-card">

        <h1>Add Product</h1>

        <p class="auth-subtitle">
          Add a new product to OFRA BH.
        </p>


        <form
          action="/products"
          method="POST"
          class="auth-form"
        >

          <div class="form-group">

            <label for="name">
              Product Name
            </label>

            <input
              type="text"
              name="name"
              id="name"
              required
            />

          </div>


          <div class="form-group">

            <label for="category">
              Category
            </label>

            <select
              name="category"
              id="category"
              required
            >

              <option value="">
                Select Category
              </option>

              <option value="Highlighter">
                Highlighter
              </option>

              <option value="Lipstick">
                Lipstick
              </option>

              <option value="Skin Care">
                Skin Care
              </option>

            </select>

          </div>


          <div class="form-group">

            <label for="shade">
              Shade
            </label>

            <input
              type="text"
              name="shade"
              id="shade"
            />

          </div>


          <div class="form-group">

            <label for="price">
              Price
            </label>

            <input
              type="number"
              name="price"
              id="price"
              required
            />

          </div>


          <div class="form-group">

            <label for="stock">
              Stock
            </label>

            <input
              type="number"
              name="stock"
              id="stock"
            />

          </div>


          <div class="form-group">

            <label for="image">
              Image Path
            </label>

            <input
              type="text"
              name="image"
              id="image"
              placeholder="/images/dubai-lipstick.png"
            />

          </div>


          <div class="form-group">

            <label for="description">
              Description
            </label>

            <textarea
              name="description"
              id="description"
            ></textarea>

          </div>


          <button
            type="submit"
            class="auth-button"
          >
            Add Product
          </button>

        </form>


        <a
          href="/products/categories"
          class="back-link"
        >
          Back to Categories
        </a>

      </section>

    </main>

    <%- include('../partials/_footer.ejs') %>
  </body>
</html>