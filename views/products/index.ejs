<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products</title>
  </head>

  <body>
    <h1>Our Products</h1>

    <% products.forEach((product) => { %>
      <div>
        <h2><%= product.name %></h2>
        <p><%= product.price %> BHD</p>

        <a href="/products/<%= product._id %>">Details</a>
      </div>
    <% }) %>
  </body>
</html>