<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />

    <title>OFRA BH | Products</title>
  </head>

  <body>
    <%- include('../partials/_navbar.ejs') %>

    <main class="products-page">
      <section class="collection-heading">
        <h1>OUR COLLECTION</h1>

        <div class="heading-decoration">
          <span></span>
          <span class="heart">♥</span>
          <span></span>
        </div>

        <p>Find your perfect glow.</p>
      </section>

      <section class="products-container">
        <% products.forEach((product) => { %>

          <% const productName = product.name.trim().toLowerCase(); %>
          <% let imagePath = ''; %>

          <% if (productName.includes('rodeo')) { %>
            <% imagePath = '/images/rodeo-drive.png'; %>
          <% } else if (productName.includes('pink')) { %>
            <% imagePath = '/images/pink-bliss.png'; %>
          <% } else if (productName.includes('beverly')) { %>
            <% imagePath = '/images/beverly-hills.png'; %>
          <% } %>

          <article class="product-card">

            <div class="product-image">
              <a href="/products/<%= product._id %>">
                <img
                  src="<%= imagePath %>"
                  alt="<%= product.name %>"
                />
              </a>
            </div>

            <h2><%= product.name %></h2>

          </article>

        <% }) %>
      </section>
    </main>

    <%- include('../partials/_footer.ejs') %>
  </body>
</html>